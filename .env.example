# ==============================================================================
# KA COMM — AI-Powered Omnichannel Communication Platform
# ==============================================================================
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is already in .gitignore.
#
# All variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] have sensible defaults.

# ==============================================================================
# Supabase Infrastructure [REQUIRED]
# Authentication, Database, Realtime, Storage
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================================================
# Zernio Social Integration [REQUIRED]
# The master Zernio API key for the platform. Server-side only.
# Customer workspaces get isolated Zernio profiles automatically.
# Get this from: https://app.zernio.com/settings/api-keys
# ==============================================================================
ZERNIO_API_KEY=your-platform-zernio-api-key

# ==============================================================================
# OAuth Security [REQUIRED]
# Secret key used to sign and verify OAuth state tokens during channel connection.
# Generate with: openssl rand -hex 32
# ==============================================================================
OAUTH_STATE_SECRET=your-random-32-character-secret-key

# ==============================================================================
# Application Settings [REQUIRED]
# ==============================================================================
NEXT_PUBLIC_APP_NAME=KA COMM
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Background Jobs [REQUIRED for production]
# Secret used to authenticate /api/cron/* endpoints.
# In Vercel, this is auto-set as CRON_SECRET.
# Generate with: openssl rand -hex 32
# ==============================================================================
CRON_SECRET=your-secure-cron-secret

# ==============================================================================
# AI Gateway [OPTIONAL]
# Platform-level API key for AI response flow nodes.
# Workspaces can also set their own keys in Settings.
# Supports Vercel AI Gateway, OpenAI, Anthropic, etc.
# ==============================================================================
# AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# ==============================================================================
# Observability [OPTIONAL]
# ==============================================================================
# VERCEL_ANALYTICS_ID=your-analytics-id
