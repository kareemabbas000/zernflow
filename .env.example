# ==============================================================================
# ZernFlow Multi-Tenant White-Label SaaS Platform Configuration
# ==============================================================================

# Supabase Infrastructure (Authentication, Database, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Platform Zernio Integration (Server-Side Only)
# The master Zernio API key belongs to the SaaS platform itself.
# Customer workspaces are automatically provisioned isolated Zernio profiles.
ZERNIO_API_KEY=your-platform-zernio-api-key

# Cryptographic OAuth Security
# Secret key used to sign and verify OAuth state tokens during channel connection.
OAUTH_STATE_SECRET=your-random-32-character-secret-key

# White-Label SaaS Branding
NEXT_PUBLIC_APP_NAME=ZernFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Background Job Engine & Sequences (Cron Secret)
# Used to protect /api/cron/jobs and /api/cron/sequences
CRON_SECRET=your-secure-cron-secret

# AI Gateway (Optional Platform Fallback for AI Response flow nodes)
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
