{
  "framework": "nextjs",
  "functions": {
    "api/webhooks/late/route.ts": {
      "maxDuration": 30
    },
    "api/cron/**": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sequences",
      "schedule": "*/5 * * * *"
    }
  ]
}
